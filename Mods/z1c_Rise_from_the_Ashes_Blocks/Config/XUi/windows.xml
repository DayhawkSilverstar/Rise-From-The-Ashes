<configs>
  <!-- Remove any previous definitions to avoid dupes -->
  <remove xpath="/windows/window[@name='windowToolscomputerStation']"/>
  <remove xpath="/windows/window[@name='windowToolsTailorWorkstation']"/>
  <remove xpath="/windows/window[@name='windowComputerDecrytionStation']"/>

  <!-- Re-add minimal, valid windows (matches what’s already present in your processed dump) -->
  <append xpath="/windows">
    <window name="windowToolscomputerStation" width="228" height="121" panel="Right" cursor_area="true">
      <panel style="header.panel">
        <sprite style="header.icon" sprite="ui_game_symbol_computer"/>
        <label style="header.name" text="TOOLS" text_key="xuiTools"/>
      </panel>
    </window>

    <window name="windowToolsTailorWorkstation" width="228" height="121" panel="Right" cursor_area="true">
      <panel style="header.panel">
        <sprite style="header.icon" sprite="ui_game_symbol_tailoring"/>
        <label style="header.name" text="TOOLS" text_key="xuiTools"/>
      </panel>
    </window>

    <!-- Keep the existing name EXACTLY as found in the dump (“Decrytion”) -->
    <window name="windowComputerDecrytionStation" width="228" height="121" panel="Right" cursor_area="true">
      <panel style="header.panel">
        <sprite style="header.icon" sprite="ui_game_symbol_computer"/>
        <label style="header.name" text="TOOLS" text_key="xuiTools"/>
      </panel>
    </window>
  </append>
</configs>