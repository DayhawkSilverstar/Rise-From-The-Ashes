  <configs>
    <append xpath="/controls">

      <!-- 50-px item stack for the 10 × 9 backpack grid -->
      <rfta_stack controller="ItemStack"
                  on_scroll="false" allow_dropping="true"
                  prefix_id="false" show_favorites="false">

        <!-- cell: 50 × 50  -->
        <rect controller="${controller}" style="kh60_itemStack, hover"
              collider_scale="1.0"
              on_scroll="${on_scroll}" allow_dropping="${allow_dropping}"
              prefix_id="${prefix_id}" show_favorites="${show_favorites}"
              tooltip="{tooltip}">

          <!-- outer border -->
          <sprite depth="2" name="backgroundMain" sprite="menu_empty3px"
                  width="50" height="50" color="[black]" type="sliced"
                  fillcenter="false"/>

          <!-- selection border -->
          <sprite depth="3" name="background" sprite="menu_empty3px"
                  width="48" height="48" color="{selectionbordercolor}"
                  type="sliced" globalopacity="true" fillcenter="false"/>

          <!-- hover / rarity tint -->
          <sprite depth="2" name="highlightOverlay"
                  width="48" height="48" color="{backgroundcolor}"
                  type="sliced" globalopacity="true"/>

          <!-- optional texture -->
          <texture depth="3" name="backgroundTexture"
                   material="Materials/Transparent Colored"
                   size="48,48" globalopacity="true"/>

          <!-- favourite star -->
          <sprite depth="8" name="favoriteIcon" sprite="server_favorite"
                  width="18" height="18" pos="1,-1"
                  foregroundlayer="true" visible="{isfavorite}"/>

          <!-- item icon -->
          <sprite depth="6" name="itemIcon" atlas="ItemIconAtlas"
                  sprite="{itemicon}" width="38" height="38"
                  pos="25,-25" pivot="center" foregroundlayer="true"
                  color="{iconcolor}"/>

          <!-- type / quality overlays -->
          <sprite depth="8" name="lockTypeIcon" width="7" height="7"
                  sprite="{locktypeicon}" pos="2,-2" foregroundlayer="true"/>
          <sprite depth="8" name="itemtypeicon" width="20" height="20"
                  sprite="ui_game_symbol_{itemtypeicon}" pos="2,-2"
                  foregroundlayer="true" visible="{hasitemtypeicon}"
                  color="{itemtypeicontint}"/>

          <!-- durability bar (46-px wide) -->
          <sprite depth="3" name="durabilityBackground" sprite="menu_empty3px"
                  width="46" height="4" pos="2,-44" type="sliced"
                  color="[darkGrey]" foregroundlayer="true"
                  visible="{hasdurability}"/>

          <filledsprite depth="4" name="durability" sprite="menu_empty2px"
                        width="46" height="4" pos="2,-44" type="filled"
                        fill="{durabilityfill}" color="{durabilitycolor}"
                        foregroundlayer="true" visible="{hasdurability}"/>

          <!-- disabled overlay -->
          <sprite depth="5" name="disabledOverlay" width="48" height="48"
                  color="[darkGrey_half_alpha]" visible="false"/>

          <!-- stack count / timer -->
          <label depth="7" name="stackValue" width="44" height="14"
                 pos="-1,-32" font_size="16" effect="outline"
                 justify="{#hasdurability ? 'Center' : 'Right'}"
                 text="{itemcount}"/>

          <label depth="7" name="timer" width="42" height="14"
                 pos="24,-33" pivot="center" font_size="16"
                 justify="center" effect="outline" color="[beige]"/>

          <!-- cancel / assemble icons -->
          <sprite depth="9" name="cancel" sprite="ui_game_symbol_x"
                  width="42" height="42" color="255,0,0,255"
                  visible="false" foregroundlayer="true"/>

          <sprite depth="13" name="assembleIcon" size="22,22"
                  sprite="{stacklockicon}" color="{stacklockcolor}"
                  visible="{isassemblelocked}" pos="12,-12"
                  foregroundlayer="true"/>

          <!-- slot-lock toggle & icon -->
          <button name="rectSlotLock" depth="15" style="press, hover"
                  width="50" height="50" visible="{userlockmode}"
                  hoverscale="1" use_selection_box="true">
            <sprite depth="16" name="button"
                    sprite="{# userlockedslot ? 'ui_game_symbol_lock'
                                            : 'ui_game_symbol_unlock'}"
                    width="14" height="14" pos="34,-8" pivot="center"
                    color="{# userlockedslot ? '222,206,163'
                                          : '255,255,255'}"/>
          </button>

          <sprite depth="15" name="iconSlotLock" sprite="ui_game_symbol_lock"
                  width="12" height="12" pos="36,-6" pivot="center"
                  visible="{# userlockedslot and !userlockmode}"
                  color="[white]"/>

        </rect>
      </rfta_stack>
    </append>
  </configs>